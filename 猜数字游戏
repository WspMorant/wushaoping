<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    ɵ<title>🔢 猜数字游戏</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
        }
        body {
            background: linear-gradient(145deg, #1e2b3c 0%, #0f1a26 100%);
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        .game-container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 48px;
            padding: 32px 28px;
            max-width: 560px;
            width: 100%;
            box-shadow: 0 30px 50px rgba(0, 0, 0, 0.6), inset 0 1px 3px rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.2s;
        }
        h1 {
            text-align: center;
            font-weight: 600;
            font-size: 2.3rem;
            letter-spacing: 2px;
            margin-top: 0;
            margin-bottom: 12px;
            color: #eef5ff;
            text-shadow: 0 4px 12px rgba(0, 20, 50, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }
        h1 span {
            font-size: 2.6rem;
            filter: drop-shadow(0 6px 8px #00000055);
        }
        .range-badge {
            text-align: center;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 100px;
            padding: 10px 18px;
            margin: 8px 0 24px 0;
            font-size: 1.1rem;
            font-weight: 500;
            color: #aac8ff;
            border: 1px solid rgba(120, 170, 255, 0.2);
            display: inline-block;
            width: auto;
            margin-left: auto;
            margin-right: auto;
            display: table;
            backdrop-filter: blur(4px);
        }
        .guess-area {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            margin-bottom: 24px;
        }
        .guess-input {
            flex: 2 1 180px;
            background: #0b1219;
            border: 2px solid #2d4055;
            border-radius: 60px;
            padding: 16px 22px;
            font-size: 1.3rem;
            font-weight: 500;
            color: #f0f7ff;
            outline: none;
            transition: 0.15s;
            text-align: center;
            letter-spacing: 1px;
            box-shadow: inset 0 4px 8px rgba(0, 0, 0, 0.6), 0 1px 0 rgba(255, 255, 255, 0.05);
        }
        .guess-input:focus {
            border-color: #5d9eff;
            box-shadow: 0 0 0 4px rgba(80, 150, 255, 0.2), inset 0 2px 6px #000000;
            background: #0e1722;
        }
        .guess-input::placeholder {
            color: #5f7a9a;
            font-weight: 400;
            font-size: 1rem;
            letter-spacing: 0.5px;
        }
        button {
            background: linear-gradient(135deg, #2f5f9e, #1d3e66);
            border: none;
            border-radius: 60px;
            padding: 16px 28px;
            font-size: 1.2rem;
            font-weight: 600;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.1s ease;
            box-shadow: 0 10px 18px -6px #00000080, 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            letter-spacing: 0.5px;
            flex: 1 0 120px;
        }
        button:hover {
            background: linear-gradient(135deg, #3e74bd, #255088);
            transform: scale(1.02);
            box-shadow: 0 14px 22px -8px #000000b0, 0 0 0 1px rgba(255, 255, 255, 0.2) inset;
        }
        button:active {
            transform: scale(0.98);
            box-shadow: 0 4px 10px -2px #000000cc, 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
        }
        button:disabled {
            opacity: 0.45;
            transform: none;
            pointer-events: none;
            filter: grayscale(0.6);
            box-shadow: none;
        }
        .new-btn {
            background: linear-gradient(135deg, #3d4f64, #26323f);
            box-shadow: 0 8px 16px -6px #00000080, 0 0 0 1px rgba(255, 255, 255, 0.05) inset;
        }
        .new-btn:hover {
            background: linear-gradient(135deg, #526a84, #324252);
        }
        .message-box {
            background: #0b1219cc;
            border-radius: 32px;
            padding: 22px 20px;
            margin: 22px 0 20px;
            text-align: center;
            font-size: 1.25rem;
            font-weight: 500;
            color: #e0ecff;
            border: 1px solid #2b4058;
            backdrop-filter: blur(10px);
            box-shadow: inset 0 2px 8px #00000055, 0 8px 18px -8px black;
            min-height: 86px;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1.5;
            word-break: break-word;
        }
        .history-panel {
            background: #0b1219aa;
            border-radius: 28px;
            padding: 18px 20px;
            margin-top: 16px;
            border: 1px solid #1f3143;
        }
        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #a0bbdd;
            font-weight: 500;
            font-size: 0.95rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 12px;
            padding: 0 6px;
        }
        .history-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 12px;
            min-height: 40px;
            align-items: center;
        }
        .guess-chip {
            background: #1a2a3b;
            border-radius: 40px;
            padding: 8px 16px;
            font-weight: 600;
            font-size: 1.1rem;
            color: #c6dfff;
            border: 1px solid #2f4b6b;
            box-shadow: 0 2px 6px #00000030;
            transition: 0.1s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .guess-chip.low {
            border-left: 6px solid #4f9eff;
            background: #1a2e44;
        }
        .guess-chip.high {
            border-left: 6px solid #ff7b7b;
            background: #2e1f26;
        }
        .guess-chip.correct {
            border-left: 6px solid #5ae08b;
            background: #1a3a2a;
            color: #c6ffd6;
        }
        .empty-history {
            color: #5d738b;
            font-style: italic;
            font-size: 1rem;
            padding: 6px 8px;
            opacity: 0.8;
        }
        .attempt-counter {
            background: #1a2a3b;
            border-radius: 40px;
            padding: 4px 14px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #b8d6ff;
        }
        .footer-note {
            text-align: center;
            margin-top: 16px;
            font-size: 0.8rem;
            color: #3e5c7c;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
    <div class="game-container">
        <h1>
            <span>🎲</span> 猜数字 <span>🎯</span>
        </h1>
        <div class="range-badge">
            🔍 范围 1 – 100
        </div>

        <!-- 输入 + 按钮 -->
        <div class="guess-area">
            <input type="number" id="guessInput" class="guess-input" placeholder="输入数字" min="1" max="100" inputmode="numeric">
            <button id="guessBtn">猜！</button>
        </div>

        <!-- 消息显示区 -->
        <div id="messageBox" class="message-box">
            💡 输入数字开始游戏
        </div>

        <!-- 历史记录 + 重置 -->
        <div class="history-panel">
            <div class="history-header">
                <span>📋 猜测记录</span>
                <span id="attemptCounter" class="attempt-counter">0 次</span>
            </div>
            <div id="historyList" class="history-list">
                <span class="empty-history">还没有猜测</span>
            </div>
        </div>

        <!-- 新游戏按钮 -->
        <button id="newGameBtn" class="new-btn" style="width:100%; margin-top: 18px;">
            🔄 新游戏
        </button>
        <div class="footer-note">
            ⚡ 猜错了会提示高低哦
        </div>
    </div>

    <script>
        (function() {
            // ----- 游戏状态 -----
            let secretNumber = 0;          // 随机秘密数字
            let attempts = 0;             // 尝试次数
            let gameOver = false;         // 游戏是否结束 (猜中后禁用)
            let guessesHistory = [];      // 存储 { value, result } 结果: 'low' | 'high' | 'correct'

            // ----- DOM 元素 -----
            const guessInput = document.getElementById('guessInput');
            const guessBtn = document.getElementById('guessBtn');
            const newGameBtn = document.getElementById('newGameBtn');
            const messageBox = document.getElementById('messageBox');
            const historyList = document.getElementById('historyList');
            const attemptCounter = document.getElementById('attemptCounter');

            // ----- 工具函数：生成 1~100 随机整数 (含1和100) -----
            function generateSecret() {
                return Math.floor(Math.random() * 100) + 1;
            }

            // ----- 更新界面上的尝试次数 -----
            function updateAttemptCounter() {
                attemptCounter.textContent = `${attempts} 次`;
            }

            // ----- 渲染历史记录 (根据 guessesHistory) -----
            function renderHistory() {
                // 清空容器
                historyList.innerHTML = '';

                if (guessesHistory.length === 0) {
                    // 显示没有猜测的占位符
                    const emptySpan = document.createElement('span');
                    emptySpan.className = 'empty-history';
                    emptySpan.textContent = '还没有猜测';
                    historyList.appendChild(emptySpan);
                    return;
                }

                // 遍历历史记录，创建小标签
                guessesHistory.forEach(item => {
                    const chip = document.createElement('span');
                    chip.className = `guess-chip ${item.result}`; // low / high / correct

                    // 根据结果添加图标
                    let icon = '';
                    if (item.result === 'low') icon = '⬆️';      // 太小了 → 提示往大猜
                    else if (item.result === 'high') icon = '⬇️'; // 太大了 → 提示往小猜
                    else if (item.result === 'correct') icon = '🎉';

                    chip.textContent = `${icon} ${item.value}`;
                    historyList.appendChild(chip);
                });
            }

            // ----- 重置游戏 (重新开始) -----
            function resetGame() {
                // 生成新的秘密数字
                secretNumber = generateSecret();
                attempts = 0;
                gameOver = false;
                guessesHistory = [];

                // 清空输入框
                guessInput.value = '';
                // 启用输入框和按钮
                guessInput.disabled = false;
                guessBtn.disabled = false;
                // 移除输入框的只读样式 (如果有)
                guessInput.focus();

                // 更新消息
                messageBox.textContent = '💡 输入数字开始游戏 (1-100)';
                // 更新计数
                updateAttemptCounter();
                // 渲染历史 (清空后显示占位符)
                renderHistory();

                // 调试时可打印秘密数字 (但正式环境注释掉)
                // console.log(`[debug] 新的秘密数字: ${secretNumber}`);
            }

            // ----- 处理猜测逻辑 -----
            function handleGuess() {
                // 如果游戏已经结束 (猜中了)，不允许继续猜测
                if (gameOver) {
                    messageBox.textContent = '🎯 游戏已结束，点击“新游戏”再来一局吧！';
                    return;
                }

                // 获取输入并转为数字
                const rawValue = guessInput.value.trim();
                if (rawValue === '') {
                    messageBox.textContent = '⚠️ 请输入一个数字 (1-100)';
                    guessInput.focus();
                    return;
                }

                const guess = Number(rawValue);

                // 校验：是否为整数，是否在 1~100 之间
                if (!Number.isInteger(guess) || guess < 1 || guess > 100) {
                    messageBox.textContent = '❌ 请输入 1 到 100 之间的整数';
                    guessInput.value = '';  // 清空方便重新输入
                    guessInput.focus();
                    return;
                }

                // 有效猜测：增加尝试次数
                attempts++;
                updateAttemptCounter();

                // 比较大小
                let resultType = '';
                let feedbackMessage = '';

                if (guess === secretNumber) {
                    // 猜中啦！
                    resultType = 'correct';
                    feedbackMessage = `🎉 太厉害了！就是 ${secretNumber}！ 你用了 ${attempts} 次猜中。`;
                    gameOver = true;
                    guessInput.disabled = true;
                    guessBtn.disabled = true;
                } else if (guess < secretNumber) {
                    resultType = 'low';
                    feedbackMessage = `📈 ${guess} 太小了，再往大猜猜～`;
                } else { // guess > secretNumber
                    resultType = 'high';
                    feedbackMessage = `📉 ${guess} 太大了，往小猜猜～`;
                }

                // 保存到历史记录
                guessesHistory.push({ value: guess, result: resultType });

                // 更新消息和界面
                messageBox.textContent = feedbackMessage;
                renderHistory();

                // 清空输入框并聚焦，方便下一次输入
                guessInput.value = '';
                if (!gameOver) {
                    guessInput.focus();
                }
            }

            // ----- 初始化/重置 (页面加载时调用) -----
            function initGame() {
                resetGame();
            }

            // ----- 事件绑定 -----
            // 点击“猜！”按钮
            guessBtn.addEventListener('click', handleGuess);

            // 在输入框按回车键触发猜测
            guessInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();  // 防止意外提交
                    handleGuess();
                }
            });

            // 点击新游戏按钮
            newGameBtn.addEventListener('click', () => {
                resetGame();
            });

            // 页面加载完成后启动游戏
            window.addEventListener('load', initGame);

        })();
    </script>
</body>
</html>
